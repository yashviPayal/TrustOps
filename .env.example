# TrustOps Environment Configuration Example

# Paths
MODEL_DIR=models
DATA_PATH=data/raw/creditcard.csv
HELD_OUT_STREAM_PATH=data/processed/held_out_stream.json
MLFLOW_TRACKING_URI=http://localhost:5000

# Rollout & Canary Settings
ROLLOUT_MODE=champion
CANARY_PERCENT=15
CANARY_MAX_LATENCY_MS=500
CANARY_LATENCY_FAILURES=5
CANARY_ERROR_FAILURES=3

# Data Drift Settings
DRIFT_WINDOW_SIZE=500
DRIFT_MIN_SAMPLES=50
DRIFT_KS_ALPHA=0.05
DRIFT_PSI_THRESHOLD=0.20
DRIFT_EFFECT_SIZE_THRESHOLD=0.15

# Concept Drift & Performance Monitoring
PERFORMANCE_WINDOW_SIZE=100
PERFORMANCE_F1_ALERT_THRESHOLD=0.60

# Observability Credentials
GRAFANA_PASSWORD=admin
