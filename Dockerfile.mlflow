FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /tracking
RUN pip install --no-cache-dir mlflow==2.22.0

EXPOSE 5000
CMD ["python", "-m", "mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////tracking/mlflow.db", "--serve-artifacts", "--artifacts-destination", "/tracking/artifacts"]
